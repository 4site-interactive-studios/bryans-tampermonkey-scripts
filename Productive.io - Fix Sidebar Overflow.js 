// ==UserScript==
// @name         Productive.io - Fix Sidebar Overflow
// @namespace    http://tampermonkey.net/
// @version      1.0
// @description  Adjusts the sidebar dropdowns on Productive.io to prevent overflow issues
// @icon         https://www.google.com/s2/favicons?sz=64&domain=productive.io
// @author       Bryan
// @match        *://app.productive.io/*
// @grant        GM_addStyle
// ==/UserScript==

(function() {
    'use strict';

    GM_addStyle(`
        .task-form-page__sidebar .select-field-standard-item > div {
            overflow: visible !important;
            text-wrap: auto !important;
        }
    `);
})();
